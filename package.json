{
  "name": "virtual-scenario",
  "version": "1.1.0",
  "description": "VirtualScenario - 코레일 안전교육 시나리오 에디터 & 3D 시뮬레이터",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:host": "concurrently \"npm run dev:backend\" \"npm run dev:frontend:host\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:frontend:host": "cd frontend && npm run dev:host",
    "dev:backend": "cd backend && npm run dev",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "build": "cd backend && npm run build:all",
    "package": "cd backend && npm run package",
    "package:win": "cd backend && npm run package:win",
    "package:mac": "cd backend && npm run package:mac",
    "package:linux": "cd backend && npm run package:linux"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "",
  "license": "ISC"
}
