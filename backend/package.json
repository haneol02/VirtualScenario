{
  "name": "virtual-scenario-backend",
  "version": "0.1.0",
  "description": "VirtualScenario - 코레일 안전교육 시나리오 에디터 & 3D 시뮬레이터",
  "main": "dist/main.js",
  "author": "Dong-A University AI Department",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:all": "npm run build && cd ../frontend && npm run build && cd ../backend && npm run copy-frontend",
    "copy-frontend": "node -e \"require('fs').cpSync('../frontend/dist', 'frontend-dist', { recursive: true, force: true })\"",
    "start": "node dist/server.js",
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "package": "npm run build:all && electron-builder",
    "package:win": "npm run build:all && electron-builder --win",
    "package:mac": "npm run build:all && electron-builder --mac",
    "package:linux": "npm run build:all && electron-builder --linux"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "fs-extra": "^11.2.0",
    "multer": "^2.0.2",
    "sqlite3": "^5.1.7",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.dongauniv.virtualscenario",
    "productName": "VirtualScenario",
    "directories": {
      "output": "../release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "frontend-dist",
        "to": "frontend-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "database",
        "to": "database",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
